FROM node:22-bookworm-slim AS codex
ARG CODEX_CLI_VERSION=0.165.0
RUN npm install -g @openai/codex@${CODEX_CLI_VERSION} && codex --version

FROM ghcr.io/actions/actions-runner:latest
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git gh python3 ripgrep sudo util-linux poppler-utils \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1002 --shell /bin/bash codex \
    && chmod 700 /home/runner /home/codex
COPY --from=codex /usr/local/bin/node /usr/local/bin/node
COPY --from=codex /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
    && codex --version
COPY codex-review/ /opt/codex-review/
RUN chmod 755 /opt/codex-review/*.sh
RUN rm /usr/local/bin/codex \
    && ln -s /opt/codex-review/codex-locked.sh /usr/local/bin/codex
ENV CODEX_HOME=/home/codex/.codex
WORKDIR /home/runner
ENTRYPOINT ["/opt/codex-review/entrypoint.sh"]
