FROM codex-pr-review-runner:local
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl jq python3-venv python3-yaml pkg-config libpq-dev \
    && rm -rf /var/lib/apt/lists/* \
    && usermod -aG runner codex \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install -g pnpm@11.7.0
COPY coding-runner/ /opt/codex-coding/
RUN chmod 755 /opt/codex-coding/*.sh
WORKDIR /workspace
ENTRYPOINT ["/opt/codex-coding/entrypoint.sh"]
