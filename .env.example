# Copy to .env and set the repository served by these runners.
GITHUB_URL=https://github.com/OWNER/REPOSITORY

# Temporary GitHub Actions registration tokens; keep real values in .env only.
RUNNER_TOKEN=
REVIEW_RUNNER_TOKEN=

# Optional review runner settings.
CODEX_RUNNER_NAME=codex-pr-review-1
REVIEW_CODEX_VERSION=0.165.0
REVIEW_CLAUDE_VERSION=2.1.326

# PR review CLI: claude (default) or codex. Recreate the review container after changing.
REVIEW_PROVIDER=claude
# REVIEW_CLAUDE_MODEL=claude-opus-5-5
# REVIEW_CLAUDE_EFFORT=high

# Issue coding CLI: claude (default) or codex. Restart ./run-issues.sh after changing.
CODING_PROVIDER=claude
# CODING_CLAUDE_MODEL=claude-opus-5-5
# CODING_CLAUDE_EFFORT=high
# CODING_CODEX_MODEL=gpt-6-astra
# CODING_CODEX_EFFORT=high

# Ubuntu workers: install codex-review/apparmor.profile before enabling.
# Review container also needs -f compose.codex-review.apparmor.yml.
# CODEX_APPARMOR_PROFILE=codex-runner
